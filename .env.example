# ====================
# Docker Compose Environment Variables (1GB RAM Optimized)
# ====================
# Copy this file as .env and fill in your MongoDB Atlas credentials

# MongoDB Connection Strings (each core service gets its own database)
MONGO_URI_AUTH=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/pos_auth_db?retryWrites=true&w=majority
MONGO_URI_INVENTORY=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/pos_inventory_db?retryWrites=true&w=majority
MONGO_URI_ORDER=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/pos_order_db?retryWrites=true&w=majority

# JWT Secret (shared by auth-service)
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
