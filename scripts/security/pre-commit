# ============================================================
# Git Pre-commit Hook - Security Gate
# ============================================================
# Installation:
#   cp scripts/security/pre-commit .git/hooks/pre-commit
#   chmod +x .git/hooks/pre-commit
#
# Or use husky:
#   npm install --save-dev husky
#   npx husky add .git/hooks/pre-commit "bash scripts/security/pre-commit"
#
# What this hook does:
#   1. Detects secrets (TruffleHog)
#   2. Prevents .env files from being committed
#   3. Runs ESLint on staged JS files
#   4. Validates JSON syntax in staged JSON files
# ============================================================

#!/usr/bin/env bash
set -euo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo ""
echo "  POS System - Pre-commit Security Gate"
echo "  ======================================"
echo ""

FAILED=0

# ---- 1. Prevent committing .env files ----
echo "  [1/4] Checking for .env files..."
ENV_FILES=$(git diff --cached --name-only | grep -E '^\.env$|\.env\.' | grep -v '\.env\.example' || true)
if [ -n "$ENV_FILES" ]; then
  echo -e "  ${RED}BLOCKED${NC}: Attempting to commit .env file(s):"
  echo "$ENV_FILES" | while read -r f; do echo "         - $f"; done
  echo "         Add .env to .gitignore and use .env.example instead."
  FAILED=$((FAILED+1))
else
  echo -e "  ${GREEN}PASS${NC}:    No .env files staged"
fi

# ---- 2. Detect secrets with TruffleHog (if installed) ----
echo "  [2/4] Scanning for secrets..."
if command -v trufflehog &>/dev/null; then
  if trufflehog git file://. --only-verified --since-commit HEAD --fail --no-update 2>/dev/null; then
    echo -e "  ${GREEN}PASS${NC}:    No verified secrets detected"
  else
    echo -e "  ${RED}BLOCKED${NC}: TruffleHog detected secrets - commit rejected"
    FAILED=$((FAILED+1))
  fi
else
  echo -e "  ${YELLOW}SKIP${NC}:    TruffleHog not installed (run: brew install trufflehog)"
fi

# ---- 3. ESLint on staged JS files ----
echo "  [3/4] Running ESLint..."
STAGED_JS=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(js|mjs|cjs)$' || true)
if [ -n "$STAGED_JS" ]; then
  # Find eslint in any service's node_modules or globally
  ESLINT_BIN=$(find . -path "*/node_modules/.bin/eslint" -not -path "*/.git/*" | head -1 2>/dev/null || which eslint 2>/dev/null || echo "")
  if [ -n "$ESLINT_BIN" ]; then
    if echo "$STAGED_JS" | xargs "$ESLINT_BIN" --max-warnings=0 2>&1; then
      echo -e "  ${GREEN}PASS${NC}:    ESLint passed"
    else
      echo -e "  ${RED}BLOCKED${NC}: ESLint errors detected"
      FAILED=$((FAILED+1))
    fi
  else
    echo -e "  ${YELLOW}SKIP${NC}:    ESLint not found"
  fi
else
  echo -e "  ${GREEN}PASS${NC}:    No JS files staged"
fi

# ---- 4. Validate staged JSON files ----
echo "  [4/4] Validating JSON files..."
STAGED_JSON=$(git diff --cached --name-only --diff-filter=ACM | grep '\.json$' | grep -v 'package-lock.json' || true)
JSON_ERRORS=0
if [ -n "$STAGED_JSON" ]; then
  while IFS= read -r f; do
    if python3 -m json.tool "$f" > /dev/null 2>&1; then
      echo -e "           ${GREEN}OK${NC}: $f"
    else
      echo -e "           ${RED}FAIL${NC}: $f - invalid JSON"
      JSON_ERRORS=$((JSON_ERRORS+1))
    fi
  done <<< "$STAGED_JSON"
  if [ $JSON_ERRORS -gt 0 ]; then
    FAILED=$((FAILED+1))
  fi
else
  echo -e "  ${GREEN}PASS${NC}:    No JSON files staged"
fi

# ---- Result ----
echo ""
if [ $FAILED -gt 0 ]; then
  echo -e "  ${RED}PRE-COMMIT GATE FAILED${NC}: $FAILED check(s) blocked the commit."
  echo "  Fix the issues above and try again."
  echo ""
  exit 1
fi
echo -e "  ${GREEN}ALL CHECKS PASSED${NC} - proceeding with commit"
echo ""
exit 0
